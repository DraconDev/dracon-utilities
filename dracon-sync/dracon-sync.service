[Unit]
Description=Dracon Sync (deterministic sync runtime)
After=default.target

[Service]
Type=simple
Environment=PATH=/run/wrappers/bin:%h/.local/share/flatpak/exports/bin:/var/lib/flatpak/exports/bin:%h/.nix-profile/bin:/nix/profile/bin:%h/.local/state/nix/profile/bin:/etc/profiles/per-user/%u/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin
Environment=DRACON_SYNC_POLICY=%h/dracon/utilities/sync/dracon-sync.toml
ExecStartPre=-/run/current-system/sw/bin/pkill -f "dracon-git pulse|demon-git|/demon daemon"
ExecStart=%h/.local/bin/dracon-sync daemon
Restart=on-failure
RestartSec=5
Nice=10
CPUQuota=15%
MemoryHigh=768M
MemoryMax=2G
TasksMax=96

[Install]
WantedBy=default.target
