[Unit]
Description=Dracon System Guard - Proactive disk space monitoring and cleanup
Documentation=https://github.com/DraconDev/dracon-utilities
After=network.target

[Service]
Type=simple
ExecStart=%h/.local/bin/dracon-system guard daemon
Restart=on-failure
RestartSec=10

# Run as the user who owns the service
# For system-wide deployment, create a dedicated user
# User=dracon-guard
# Group=dracon-guard

# Resource limits
MemoryMax=100M
CPUQuota=10%

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.dracon %h/Dev %h/dracon
PrivateTmp=true

[Install]
WantedBy=default.target