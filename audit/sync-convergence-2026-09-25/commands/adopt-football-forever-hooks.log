 M .githooks/pre-push
?? docs/premium/evidence/baseline-season-v1/run-2026-09-25T07-53-53-2026-09-25T07-53-53/
?? docs/premium/evidence/baseline-season-v1/run-2026-09-25T08-00-40-2026-09-25T08-00-40/
?? docs/premium/evidence/baseline-season-v1/run-2026-09-25T08-04-37-2026-09-25T08-04-37/
diff --git a/.githooks/pre-commit b/.githooks/pre-commit
index bf002c4..c847ce6 100755
--- a/.githooks/pre-commit
+++ b/.githooks/pre-commit
@@ -18,7 +18,17 @@ if [ -z "$GUARD" ] || [ ! -x "$GUARD" ]; then
   echo "pre-commit: cannot locate bucket-strategy-guard.sh; refusing commit" >&2
   exit 1
 fi
-if ! "$GUARD" --staged --json; then
+# Git exports repository-discovery overrides to hooks. Linked/submodule
+# worktrees legitimately receive an absolute GIT_DIR; commits receive a
+# temporary GIT_INDEX_FILE. Remove graph/worktree redirects before invoking
+# the fail-closed strategy so it discovers the same repository from its
+# explicit --repo root. Preserve GIT_INDEX_FILE because that temporary index
+# is the exact staged tree the pre-commit guard must measure; the guard copies
+# it into an isolated index before creating any prospective objects.
+if ! env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR \
+  -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_NAMESPACE \
+  -u GIT_SHALLOW_FILE -u GIT_GRAFT_FILE -u GIT_REPLACE_REF_BASE \
+  "$GUARD" --staged --json; then
   echo "pre-commit: bucket high-water/forward-only guard blocked this commit" >&2
   exit 1
 fi
diff --git a/.githooks/pre-push b/.githooks/pre-push
index 34e400d..de1b1cd 100755
--- a/.githooks/pre-push
+++ b/.githooks/pre-push
@@ -28,7 +28,14 @@ fi
 REFS_FILE="$(mktemp)"
 trap 'rm -f "$REFS_FILE"' EXIT
 cat >"$REFS_FILE"
-if ! "$GUARD" --refs-file "$REFS_FILE" --remote-name "$REMOTE_NAME" --remote-url "$REMOTE_URL" --json; then
+# Git exports repository-discovery overrides to hooks. Linked worktrees
+# legitimately receive an absolute GIT_DIR; remove graph/worktree redirects
+# after resolving REPO_ROOT so the fail-closed strategy measures exactly the
+# linked worktree named above rather than rejecting Git's own hook env.
+if ! env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR \
+  -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_NAMESPACE \
+  -u GIT_SHALLOW_FILE -u GIT_GRAFT_FILE -u GIT_REPLACE_REF_BASE \
+  "$GUARD" --refs-file "$REFS_FILE" --remote-name "$REMOTE_NAME" --remote-url "$REMOTE_URL" --json; then
   echo "pre-push: bucket high-water/forward-only guard blocked this push" >&2
   exit 1
 fi
